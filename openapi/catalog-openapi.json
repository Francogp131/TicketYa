"size":{"type":"integer","format":"int32"},"totalElements":{"type":"integer","format":"int64"},"totalPages":{"type":"integer","format":"int32"}}},"EventoBusquedaResponse":{"type":"object","description":"Resultado de búsqueda de eventos","properties":{"id":{"type":"string","format":"uuid"},"nombre":{"type":"string"},"tipo":{"type":"string","enum":["RECITAL","TEATRO","DEPORTE","CONFERENCIA","FESTIVAL","OTRO"]},"ciudad":{"type":"string"},"lugarNombre":{"type":"string"},"fecha":{"type":"string","format":"date-time"},"estado":{"type":"string","enum":["BORRADOR","PUBLICADO","AGOTADO","CANCELADO","FINALIZADO"]},"precioDesde":{"type":"number"}}},"PageResponseEventoBusquedaResponse":{"type":"object","properties":{"content":{"type":"array","items":{"$ref":"#/components/schemas/EventoBusquedaResponse"}},"page":{"type":"integer","format":"int32"},"size":{"type":"integer","format":"int32"},"totalElements":{"type":"integer","format":"int64"},"totalPages":{"type":"integer","format":"int32"}}},"EventoDetalleResponse":{"type":"object","description":"Detalle del evento con disponibilidad por sector","properties":{"id":{"type":"string","format":"uuid"},"nombre":{"type":"string"},"descripcion":{"type":"string"},"tipo":{"type":"string","enum":["RECITAL","TEATRO","DEPORTE","CONFERENCIA","FESTIVAL","OTRO"]},"lugarId":{"type":"string","format":"uuid"},"lugarNombre":{"type":"string"},"ciudad":{"type":"string"},"organizadorId":{"type":"string","format":"uuid"},"fecha":{"type":"string","format":"date-time"},"estado":{"type":"string","enum":["BORRADOR","PUBLICADO","AGOTADO","CANCELADO","FINALIZADO"]},"limitePorCliente":{"type":"integer","format":"int32"},"participantes":{"type":"array","items":{"type":"string"}},"sectores":{"type":"array","items":{"$ref":"#/components/schemas/SectorDetalleResponse"}}}},"SectorDetalleResponse":{"type":"object","description":"Sector con precio y disponibilidad actual","properties":{"sectorId":{"type":"string","format":"uuid"},"nombre":{"type":"string"},"tipo":{"