{"openapi":"3.1.0","info":{"title":"TicketYa - catalog-service","description":"Catálogo de lugares, sectores, asientos, eventos, precios, publicación y búsqueda.\nLos endpoints públicos se consumen a través del gateway en /api/catalog/**.\nLos errores usan RFC 7807 (application/problem+json) con los campos code y errors[].\n","license":{"name":"Uso académico - UNICEN"},"version":"1.0.0"},"servers":[{"url":"http://localhost","description":"Generated server url"}],"tags":[{"name":"Eventos","description":"Eventos, precios, publicación, estados y búsqueda"},{"name":"Lugares","description":"Lugares, sectores y asientos"},{"name":"Interno","description":"Endpoints entre servicios; no se exponen por el gateway"}],"paths":{"/api/catalog/events/{eventoId}/prices/{sectorId}":{"put":{"tags":["Eventos"],"summary":"Asignar el precio de un sector","description":"Solo sobre eventos en BORRADOR y del organizador autenticado.","operationId":"asignarPrecio","parameters":[{"name":"eventoId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"sectorId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"X-User-Id","in":"header","required":false,"schema":{"type":"string"}},{"name":"X-User-Role","in":"header","required":false,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PrecioRequest"}}},"required":true},"responses":{"200":{"description":"Precio asignado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PrecioResponse"}}}},"400":{"description":"Precio negativo (INVALID_PRICE) o sector ajeno (SECTOR_NOT_FROM_VENUE)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PrecioResponse"}}}},"403":{"description":"El evento es de otro organizador (NOT_EVENT_OWNER)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PrecioResponse"}}}},"404":{"description":"Evento o sector inexistente","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PrecioResponse"}}}},"409":{"description":"El evento ya no es editable (EVENT_NOT_EDITABLE)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PrecioResponse"}}}}}}},"/api/catalog/venues":{"get":{"tags":["Lugares"],"summary":"Listar lugares","description":"Listado paginado de lugares.","operationId":"listar","parameters":[{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":0}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":20}}],"responses":{"200":{"description":"Página de lugares","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageResponseLugarResponse"}}}}}},"post":{"tags":["Lugares"],"summary":"Crear un lugar","description":"Requiere rol ADMIN.","operationId":"crear","parameters":[{"name":"X-User-Id","in":"header","required":false,"schema":{"type":"string"}},{"name":"X-User-Role","in":"header","required":false,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CrearLugarRequest"}}},"required":true},"responses":{"201":{"description":"Lugar creado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LugarResponse"}}}},"400":{"description":"Datos inválidos (VALIDATION_ERROR)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LugarResponse"}}}},"401":{"description":"Falta identidad (UNAUTHORIZED)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LugarResponse"}}}},"403":{"description":"Rol insuficiente (FORBIDDEN)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LugarResponse"}}}}}}},"/api/catalog/venues/{venueId}/sectors":{"get":{"tags":["Lugares"],"summary":"Listar sectores de un lugar","operationId":"listarSectores","parameters":[{"name":"venueId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Sectores del lugar","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/SectorResponse"}}}}},"404":{"description":"El lugar no existe (VENUE_NOT_FOUND)","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/SectorResponse"}}}}}}},"post":{"tags":["Lugares"],"summary":"Crear un sector","description":"Un sector NUMERADO genera filas * asientosPorFila asientos. Requiere rol ADMIN.","operationId":"crearSector","parameters":[{"name":"venueId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"X-User-Id","in":"header","required":false,"schema":{"type":"string"}},{"name":"X-User-Role","in":"header","required":false,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CrearSectorRequest"}}},"required":true},"responses":{"201":{"description":"Sector creado y asientos generados","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SectorResponse"}}}},"400":{"description":"Datos inválidos (VALIDATION_ERROR)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SectorResponse"}}}},"404":{"description":"El lugar no existe (VENUE_NOT_FOUND)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SectorResponse"}}}}}}},"/api/catalog/events":{"get":{"tags":["Eventos"],"summary":"Buscar eventos","description":"Solo devuelve eventos PUBLICADO o AGOTADO. Los filtros se combinan entre sí.","operationId":"buscar","parameters":[{"name":"tipo","in":"query","description":"Tipo de evento","required":false,"schema":{"type":"string","enum":["RECITAL","TEATRO","DEPORTE","CONFERENCIA","FESTIVAL","OTRO"]}},{"name":"organizadorId","in":"query","description":"Organizador dueño del evento","required":false,"schema":{"type":"string","format":"uuid"}},{"name":"participante","in":"query","description":"Nombre de un participante","required":false,"schema":{"type":"string"}},{"name":"ciudad","in":"query","description":"Ciudad del lugar","required":false,"schema":{"type":"string"}},{"name":"fechaDesde","in":"query","description":"Desde (ISO-8601 con offset)","required":false,"schema":{"type":"string","format":"date-time"}},{"name":"fechaHasta","in":"query","description":"Hasta (ISO-8601 con offset)","required":false,"schema":{"type":"string","format":"date-time"}},{"name":"orden","in":"query","description":"FECHA_ASC, FECHA_DESC, PRECIO_ASC, PRECIO_DESC o RELEVANCIA","required":false,"schema":{"type":"string","default":"FECHA_ASC"}},{"name":"page","in":"query","description":"Número de página, desde 0","required":false,"schema":{"type":"integer","format":"int32","default":0}},{"name":"size","in":"query","description":"Tamaño de página, entre 1 y 100","required":false,"schema":{"type":"integer","format":"int32","default":20}}],"responses":{"200":{"description":"Página de eventos","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageResponseEventoBusquedaResponse"}}}},"400":{"description":"Rango de fechas inválido (INVALID_DATE_RANGE) u orden inválido (INVALID_SORT)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageResponseEventoBusquedaResponse"}}}}}},"post":{"tags":["Eventos"],"summary":"Crear un evento","description":"El evento nace en BORRADOR. Requiere rol ORGANIZER.","operationId":"crear_1","parameters":[{"name":"X-User-Id","in":"header","required":false,"schema":{"type":"string"}},{"name":"X-User-Role","in":"header","required":false,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CrearEventoRequest"}}},"required":true},"responses":{"201":{"description":"Evento creado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EventoResponse"}}}},"400":{"description":"Fecha pasada o datos inválidos (VALIDATION_ERROR)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EventoResponse"}}}},"404":{"description":"El lugar no existe (VENUE_NOT_FOUND)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EventoResponse"}}}}}}},"/api/catalog/events/{eventoId}/publish":{"post":{"tags":["Eventos"],"summary":"Publicar un evento","description":"Envía el snapshot a inventory de forma idempotente. Si inventory falla, el evento sigue en BORRADOR.","operationId":"publicar","parameters":[{"name":"eventoId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"X-User-Id","in":"header","required":false,"schema":{"type":"string"}},{"name":"X-User-Role","in":"header","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Evento publicado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EventoResponse"}}}},"403":{"description":"El evento es de otro organizador (NOT_EVENT_OWNER)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EventoResponse"}}}},"404":{"description":"El evento no existe (EVENT_NOT_FOUND)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EventoResponse"}}}},"409":{"description":"Evento incompleto (EVENT_INCOMPLETE) o no editable (EVENT_NOT_EDITABLE)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EventoResponse"}}}},"502":{"description":"Inventory no confirmó el snapshot (INVENTORY_UNAVAILABLE)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EventoResponse"}}}}}}},"/api/catalog/events/{eventoId}/cancel":{"post":{"tags":["Eventos"],"summary":"Cancelar un evento","description":"Requiere ADMIN. Si orders no responde, responde 200 con cancelacionPendiente=true.","operationId":"cancelar","parameters":[{"name":"eventoId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"X-User-Id","in":"header","required":false,"schema":{"type":"string"}},{"name":"X-User-Role","in":"header","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Evento cancelado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CancelacionResponse"}}}},"404":{"description":"El evento no existe (EVENT_NOT_FOUND)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CancelacionResponse"}}}},"409":{"description":"El evento ya está cancelado o finalizado (EVENT_NOT_CANCELLABLE)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CancelacionResponse"}}}}}}},"/internal/events/{eventoId}/availability":{"patch":{"tags":["Interno"],"summary":"Sincronizar disponibilidad de un evento","description":"Inventory lo llama cuando la disponibilidad llega a 0 (AGOTADO) o vuelve a ser positiva (PUBLICADO).","operationId":"actualizarDisponibilidad","parameters":[{"name":"eventoId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ActualizarDisponibilidadRequest"}}},"required":true},"responses":{"204":{"description":"Estado sincronizado; la operación es idempotente"},"400":{"description":"Cuerpo inválido (VALIDATION_ERROR)"},"404":{"description":"El evento no existe (EVENT_NOT_FOUND)"},"409":{"description":"La transición de estado no es válida (EVENT_NOT_EDITABLE)"}}}},"/api/catalog/venues/{venueId}":{"get":{"tags":["Lugares"],"summary":"Obtener un lugar","operationId":"obtener","parameters":[{"name":"venueId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Detalle del lugar","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LugarResponse"}}}},"404":{"description":"El lugar no existe (VENUE_NOT_FOUND)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LugarResponse"}}}}}}},"/api/catalog/events/{eventoId}":{"get":{"tags":["Eventos"],"summary":"Detalle de un evento","description":"Incluye sectores, precios y disponibilidad consultada a inventory. Un evento BORRADOR responde 404.","operationId":"detalle","parameters":[{"name":"eventoId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Detalle del evento","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EventoDetalleResponse"}}}},"404":{"description":"El evento no existe o no es visible (EVENT_NOT_FOUND)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EventoDetalleResponse"}}}},"503":{"description":"No se pudo consultar inventory (INVENTORY_UNAVAILABLE)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EventoDetalleResponse"}}}}}}}},"components":{"schemas":{"PrecioRequest":{"type":"object","description":"Precio de un sector para un evento","properties":{"precio":{"type":"number","description":"Precio no negativo","example":15000.0}},"required":["precio"]},"PrecioResponse":{"type":"object","description":"Precio asignado a un sector","properties":{"eventoId":{"type":"string","format":"uuid","description":"Evento","example":"1f2e3d4c-5b6a-4978-8a9b-0c1d2e3f4a5b"},"sectorId":{"type":"string","format":"uuid","description":"Sector","example":"9a1b2c3d-4e5f-4a6b-8c7d-1e2f3a4b5c6d"},"precio":{"type":"number","description":"Precio","example":15000.0}}},"CrearLugarRequest":{"type":"object","description":"Datos para crear un lugar","properties":{"nombre":{"type":"string","description":"Nombre del lugar","example":"Estadio Municipal","maxLength":150,"minLength":0},"direccion":{"type":"string","description":"Dirección","example":"Av. Siempre Viva 742","maxLength":255,"minLength":0},"ciudad":{"type":"string","description":"Ciudad","example":"Tandil","maxLength":120,"minLength":0},"latitud":{"type":"number","description":"Latitud entre -90 y 90","example":-37.3217,"maximum":90.0,"minimum":-90.0},"longitud":{"type":"number","description":"Longitud entre -180 y 180","example":-59.1332,"maximum":180.0,"minimum":-180.0}},"required":["ciudad","direccion","latitud","longitud","nombre"]},"LugarResponse":{"type":"object","description":"Lugar del catálogo","properties":{"id":{"type":"string","format":"uuid"},"nombre":{"type":"string"},"direccion":{"type":"string"},"ciudad":{"type":"string"},"latitud":{"type":"number"},"longitud":{"type":"number"}}},"CrearSectorRequest":{"type":"object","description":"Datos para crear un sector","properties":{"nombre":{"type":"string","description":"Nombre del sector","example":"Platea A","maxLength":120,"minLength":0},"tipo":{"type":"string","description":"NUMERADO o NO_NUMERADO","enum":["NUMERADO","NO_NUMERADO"],"example":"NUMERADO"},"capacidad":{"type":"integer","format":"int32","description":"Capacidad para sectores no numerados; en numerados se calcula filas * asientosPorFila","example":200,"minimum":1},"filas":{"type":"integer","format":"int32","description":"Filas (solo NUMERADO)","example":10,"minimum":1},"asientosPorFila":{"type":"integer","format":"int32","description":"Asientos por fila (solo NUMERADO)","example":20,"minimum":1}},"required":["nombre","tipo"]},"SectorResponse":{"type":"object","description":"Sector de un lugar con los asientos generados","properties":{"id":{"type":"string","format":"uuid"},"lugarId":{"type":"string","format":"uuid"},"nombre":{"type":"string"},"tipo":{"type":"string","enum":["NUMERADO","NO_NUMERADO"]},"capacidad":{"type":"integer","format":"int32"},"filas":{"type":"integer","format":"int32"},"asientosPorFila":{"type":"integer","format":"int32"},"asientosGenerados":{"type":"integer","format":"int64"}}},"CrearEventoRequest":{"type":"object","description":"Datos para crear un evento en BORRADOR","properties":{"nombre":{"type":"string","description":"Nombre del evento","example":"Festival de Verano","maxLength":200,"minLength":0},"descripcion":{"type":"string","description":"Descripción","example":"Una noche de música","maxLength":2000,"minLength":0},"tipo":{"type":"string","description":"Tipo de evento","enum":["RECITAL","TEATRO","DEPORTE","CONFERENCIA","FESTIVAL","OTRO"],"example":"FESTIVAL"},"lugarId":{"type":"string","format":"uuid","description":"Lugar donde se realiza","example":"5c9b1f3e-2a4d-4f5e-9a8b-1c2d3e4f5a6b"},"fecha":{"type":"string","format":"date-time","description":"Fecha y hora futura con offset","example":"2027-01-15T21:00:00-03:00"},"participantes":{"type":"array","description":"Artistas o participantes","example":["Artista A","Artista B"],"items":{"type":"string","maxLength":150,"minLength":0},"