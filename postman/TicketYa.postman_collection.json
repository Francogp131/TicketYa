                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{clientId}}" },
              { "key": "X-User-Role", "value": "CLIENT" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/reservations/{{reservaId}}",
