{
  "info": {
    "name": "TicketYa — Entrega 1 (Día 1)",
    "description": "Flujo base del Día 1 contra el gateway: catálogo, inventario y órdenes.\n\nAntes de correr:\n1. `docker compose -f docker-compose.dev.yml up -d`\n2. Levantar catalog, inventory, orders y api-gateway.\n3. Ejecutar la colección en orden (Catálogo → Inventario → Órdenes → Errores).\n\nVariables de identidad de la Entrega 1:\n- ADMIN: `11111111-1111-4111-8111-111111111111`\n- ORGANIZER: `22222222-2222-4222-8222-222222222222`\n- CLIENT: `33333333-3333-4333-8333-333333333333`\n\nLos IDs creados se guardan como variables de colección; no hace falta cargarlos a mano.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminId", "value": "11111111-1111-4111-8111-111111111111" },
    { "key": "organizerId", "value": "22222222-2222-4222-8222-222222222222" },
    { "key": "clientId", "value": "33333333-3333-4333-8333-333333333333" },
    { "key": "venueId", "value": "" },
    { "key": "numeradoSectorId", "value": "" },
    { "key": "zonaSectorId", "value": "" },
    { "key": "eventoId", "value": "" },
    { "key": "asiento1", "value": "" },
    { "key": "asiento2", "value": "" },
    { "key": "reservaId", "value": "" },
    { "key": "zonaReservaId", "value": "" },
    { "key": "ordenId", "value": "" },
    { "key": "seedEventoId", "value": "d0000000-0000-4000-8000-000000000001" },
    { "key": "seedSectorId", "value": "b0000000-0000-4000-8000-000000000001" }
  ],
  "item": [
    {
      "name": "Catálogo",
      "item": [
        {
          "name": "Listar lugares (público)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y arreglo JSON', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/catalog/venues", "host": ["{{baseUrl}}"], "path": ["api", "catalog", "venues"] }
          }
        },
        {
          "name": "Crear lugar (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 y guarda venueId', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.be.a('string');",
                  "    pm.expect(body.ciudad).to.eql('Tandil');",
                  "    pm.collectionVariables.set('venueId', body.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{adminId}}" },
              { "key": "X-User-Role", "value": "ADMIN" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Estadio Postman {{$timestamp}}\",\n  \"direccion\": \"Av. Siempre Viva 742\",\n  \"ciudad\": \"Tandil\",\n  \"latitud\": -37.3217,\n  \"longitud\": -59.1332\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/catalog/venues", "host": ["{{baseUrl}}"], "path": ["api", "catalog", "venues"] }
          }
        },
        {
          "name": "Crear sector numerado (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201, 10 asientos generados y guarda sector', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.tipo).to.eql('NUMERADO');",
                  "    pm.expect(body.capacidad).to.eql(10);",
                  "    pm.expect(body.asientosGenerados).to.eql(10);",
                  "    pm.collectionVariables.set('numeradoSectorId', body.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{adminId}}" },
              { "key": "X-User-Role", "value": "ADMIN" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Platea Postman\",\n  \"tipo\": \"NUMERADO\",\n  \"filas\": 2,\n  \"asientosPorFila\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/catalog/venues/{{venueId}}/sectors",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "venues", "{{venueId}}", "sectors"]
            }
          }
        },
        {
          "name": "Crear sector no numerado (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 y guarda sector de zona', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.tipo).to.eql('NO_NUMERADO');",
                  "    pm.expect(body.capacidad).to.eql(50);",
                  "    pm.collectionVariables.set('zonaSectorId', body.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{adminId}}" },
              { "key": "X-User-Role", "value": "ADMIN" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Campo Postman\",\n  \"tipo\": \"NO_NUMERADO\",\n  \"capacidad\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/catalog/venues/{{venueId}}/sectors",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "venues", "{{venueId}}", "sectors"]
            }
          }
        },
        {
          "name": "Crear evento (ORGANIZER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 en BORRADOR y guarda eventoId', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.estado).to.eql('BORRADOR');",
                  "    pm.expect(body.lugarId).to.eql(pm.collectionVariables.get('venueId'));",
                  "    pm.collectionVariables.set('eventoId', body.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{organizerId}}" },
              { "key": "X-User-Role", "value": "ORGANIZER" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Evento Postman {{$timestamp}}\",\n  \"descripcion\": \"Evento creado por la colección del Día 1\",\n  \"tipo\": \"RECITAL\",\n  \"lugarId\": \"{{venueId}}\",\n  \"fecha\": \"2027-06-15T21:00:00-03:00\",\n  \"participantes\": [\"Artista Postman\"],\n  \"limitePorCliente\": 4\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/catalog/events", "host": ["{{baseUrl}}"], "path": ["api", "catalog", "events"] }
          }
        },
        {
          "name": "Asignar precio sector numerado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con precio 15000', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().precio).to.eql(15000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{organizerId}}" },
              { "key": "X-User-Role", "value": "ORGANIZER" }
            ],
            "body": { "mode": "raw", "raw": "{ \"precio\": 15000.00 }" },
            "url": {
              "raw": "{{baseUrl}}/api/catalog/events/{{eventoId}}/prices/{{numeradoSectorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "events", "{{eventoId}}", "prices", "{{numeradoSectorId}}"]
            }
          }
        },
        {
          "name": "Asignar precio sector zona",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con precio 9000', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().precio).to.eql(9000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{organizerId}}" },
              { "key": "X-User-Role", "value": "ORGANIZER" }
            ],
            "body": { "mode": "raw", "raw": "{ \"precio\": 9000.00 }" },
            "url": {
              "raw": "{{baseUrl}}/api/catalog/events/{{eventoId}}/prices/{{zonaSectorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "events", "{{eventoId}}", "prices", "{{zonaSectorId}}"]
            }
          }
        },
        {
          "name": "Publicar evento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 PUBLICADO y snapshot en inventory', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().estado).to.eql('PUBLICADO');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{organizerId}}" },
              { "key": "X-User-Role", "value": "ORGANIZER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/catalog/events/{{eventoId}}/publish",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "events", "{{eventoId}}", "publish"]
            }
          }
        },
        {
          "name": "Detalle del evento publicado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con dos sectores y disponibilidad', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.estado).to.eql('PUBLICADO');",
                  "    pm.expect(body.sectores).to.have.lengthOf(2);",
                  "    pm.expect(body.sectores[0]).to.have.property('disponibles');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalog/events/{{eventoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "events", "{{eventoId}}"]
            }
          }
        },
        {
          "name": "Detalle de evento del seed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 para el evento sembrado', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().estado).to.eql('PUBLICADO');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalog/events/{{seedEventoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "events", "{{seedEventoId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Inventario",
      "item": [
        {
          "name": "Disponibilidad del evento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con los dos sectores', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.estado).to.eql('PUBLICADO');",
                  "    pm.expect(body.sectores).to.have.lengthOf(2);",
                  "    const zona = body.sectores.find(s => s.tipo === 'NO_NUMERADO');",
                  "    pm.expect(zona.disponibles).to.eql(50);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/events/{{eventoId}}/availability",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "events", "{{eventoId}}", "availability"]
            }
          }
        },
        {
          "name": "Mapa de asientos numerados",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con 10 asientos LIBRE y guarda dos', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const asientos = pm.response.json();",
                  "    pm.expect(asientos).to.have.lengthOf(10);",
                  "    pm.expect(asientos.every(a => a.estado === 'LIBRE')).to.eql(true);",
                  "    pm.collectionVariables.set('asiento1', asientos[0].asientoId);",
                  "    pm.collectionVariables.set('asiento2', asientos[1].asientoId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/events/{{eventoId}}/seats?sectorId={{numeradoSectorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "events", "{{eventoId}}", "seats"],
              "query": [{ "key": "sectorId", "value": "{{numeradoSectorId}}" }]
            }
          }
        },
        {
          "name": "Reservar 2 asientos numerados",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 VIGENTE, total 30000 y guarda reservaId', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.estado).to.eql('VIGENTE');",
                  "    pm.expect(body.items).to.have.lengthOf(2);",
                  "    pm.expect(Number(body.total)).to.eql(30000);",
                  "    pm.collectionVariables.set('reservaId', body.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{clientId}}" },
              { "key": "X-User-Role", "value": "CLIENT" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventoId\": \"{{eventoId}}\",\n  \"items\": [\n    { \"sectorId\": \"{{numeradoSectorId}}\", \"asientoIds\": [\"{{asiento1}}\", \"{{asiento2}}\"] }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/inventory/reservations", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "reservations"] }
          }
        },
