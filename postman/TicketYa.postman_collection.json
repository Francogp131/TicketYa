                  "    pm.expect(pm.response.json().code).to.eql('SEAT_NOT_AVAILABLE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{clientId}}" },
              { "key": "X-User-Role", "value": "CLIENT" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventoId\": \"{{eventoId}}\",\n  \"items\": [\n    { \"sectorId\": \"{{numeradoSectorId}}\", \"asientoIds\": [\"{{asiento1}}\", \"{{asiento2}}\"] }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/inventory/reservations", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "reservations"] }
          }
        },
        {
          "name": "Reservar 2 lugares de zona",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201, total 18000 y guarda zonaReservaId', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(Number(body.total)).to.eql(18000);",
                  "    pm.collectionVariables.set('zonaReservaId', body.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{clientId}}" },
              { "key": "X-User-Role", "value": "CLIENT" }
            ],
            "body": {
              "mode": "raw",
